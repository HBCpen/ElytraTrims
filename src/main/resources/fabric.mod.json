{
  "schemaVersion": 1,
  "id": "elytratrims_cosmetic",
  "name": "Elytra Trims Cosmetic",
  "version": "${version}",
  "authors": [
    "KikuGie"
  ],
  "contributors": [
    "masik16u",
    "HBCpen"
  ],
  "contact": {
    "homepage": "https://github.com/HBCpen/ElytraTrims",
    "sources": "https://github.com/HBCpen/ElytraTrims",
    "issues": "https://github.com/HBCpen/ElytraTrims/issues"
  },
  "description": "Client-side fork of Elytra Trims: decorate your elytra with trims, dyes and banner patterns as a pure cosmetic, without consuming items or needing the mod on the server.",
  "icon": "assets/elytratrims/icon.png",
  "license": "LGPL-3.0-or-later",
  "environment": "client",
  "accessWidener": "elytratrims.classtweaker",
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=0.13",
    "minecraft": "${minecraft}"
  },
  "suggests": {
    "lambdynlights": "*",
    "modmenu": "*"
  },
  "breaks": {
    "elytratrims": "*"
  },
  "mixins": [
    "elytratrims.mixins.json"
  ]
}
